{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=9 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" inject-h2t-context",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=29 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" gather-on-skill",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=9 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" structure-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=9 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" structure-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=9 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" structure-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=29 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" gather-on-prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=9 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" grade-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=9 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" plain-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=44 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" plan-closer",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=9 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" new-repo-hint",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H2T_HOOK_TIMEOUT=14 bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" session-end-reap-codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
