#!/usr/bin/env bash
# git pre-commit: nothing but dated Markdown enters docs/superpowers/plans|specs.
#
# Third layer of the same rule (structure-guard catches Claude's writes, the CI layout
# job catches what is already committed); this one catches files written by scripts —
# the _gc_capture_*.jsonl dumps in h2t-transcription came from a Python script, and no
# PreToolUse hook ever saw them. Install once per machine:
#
#   mkdir -p ~/.h2t/git-hooks
#   printf '#!/usr/bin/env bash\nexec h2t-hook layout-precommit "$@"\n' > ~/.h2t/git-hooks/pre-commit
#   chmod +x ~/.h2t/git-hooks/pre-commit
#   git config --global core.hooksPath ~/.h2t/git-hooks
#
# A repo with its own core.hooksPath (h2t-skills: scripts/hooks) overrides the global
# one — chain `h2t-hook layout-precommit` from that hook. Exit 1 blocks the commit.
set -euo pipefail

pattern='^docs/superpowers/(plans|specs)/([0-9]{4}-[0-9]{2}-[0-9]{2}-[^/]+\.md|README\.md|index\.md|\.gitkeep)$'
bad=$(git diff --cached --name-only --diff-filter=AR -- 'docs/superpowers/plans' 'docs/superpowers/specs' \
      | grep -vE "$pattern" || true)

if [ -n "$bad" ]; then
  echo "h2t layout-precommit: not a plan, refused in docs/superpowers/{plans,specs}/:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  echo "  scripts → scripts/; run output → docs/.artifacts/<run>/; drafts stay outside the repo." >&2
  exit 1
fi
exit 0
