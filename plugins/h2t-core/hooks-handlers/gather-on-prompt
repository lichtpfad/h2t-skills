#!/usr/bin/env bash
# UserPromptSubmit: the slash path to a session skill never reaches PreToolUse.
#
# `/h2t-core:session-start` is expanded into the prompt by the harness — no Skill tool
# call happens, so a PreToolUse:Skill matcher cannot fire. Measured 2026-08-22 with a
# dump hook in a fresh headless session:
#
#   plain text "сделай handoff"   -> Skill tool called  {"skill":"h2t-core:handoff"}
#   "/h2t-core:dev-overview"      -> UserPromptSubmit only, Skill dumper silent
#
# So the text path is already covered by gather-on-skill; this covers the slash form,
# which is the one an accurate user types. Both funnel into gather-on-skill, whose 30s
# per-cwd lock keeps a double entry from gathering twice.
set -euo pipefail

input=$(cat)

# No jq, and no interpreter either (D1, #541). Git Bash on Windows has no jq, and this hook
# runs on every message, so the common case — not a slash invocation — must leave without
# parsing anything. A slash invocation shows in the raw JSON as the prompt field opening
# with `/…session-start|handoff|init-project`; JSON escapes leading whitespace as \n, \r,
# \t. Both field names are accepted: plugin-dev/hook-development/SKILL.md says
# `user_prompt`, the shipped warp hook reads `.prompt`, measured `.prompt`.
#
# Anchored to the start of the prompt on purpose. UserPromptSubmit also fires for harness
# messages — a <task-notification> carries file paths that contain "handoff" — and for any
# sentence discussing the skills. Only a leading slash command is a real invocation.
printf '%s' "$input" | grep -qE \
  '"(user_)?prompt"[[:space:]]*:[[:space:]]*"([[:space:]]|\\[nrt])*/([A-Za-z0-9_.-]+:)?(session-start|handoff|init-project)([[:space:]"]|\\[nrt])' \
  || exit 0

# Hand the payload over unchanged to the one implementation. It parses both shapes — this
# prompt and PreToolUse's tool_input.skill — with the interpreter it resolves for its reply
# anyway, and hook_event_name in the payload picks the delivery channel: the model reads
# hookSpecificOutput.additionalContext, systemMessage is the user-visible TUI channel.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
printf '%s' "$input" | bash "$SCRIPT_DIR/gather-on-skill"
