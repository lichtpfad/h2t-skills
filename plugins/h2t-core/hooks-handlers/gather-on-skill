#!/usr/bin/env bash
# PreToolUse: inject context when h2t-core session skills are invoked.
#
# The hook is the executor on purpose. 672249e (2026-03-25) moved gathering out of the
# model's hands — "Closes #12 — gather.py can no longer be ignored by Claude". Do not
# replace this with an instruction telling the agent to run something itself.
set -euo pipefail

input=$(cat)

# No jq (D1, #541): Git Bash on Windows has none. The payload is parsed below with the
# interpreter this hook resolves for its reply anyway; until then, bash only. A relevant
# payload names one of the three skills verbatim — tool_input.skill, or the slash prompt
# gather-on-prompt hands over — so anything else leaves before an interpreter is sought.
case "$input" in
  *session-start*|*handoff*|*init-project*) ;;
  *) exit 0 ;;
esac
# The event picks the reply channel, and the error path below needs it before an
# interpreter exists. The parse confirms it; a prompt quoting the event name can only
# mislabel an error that is printed anyway.
case "$input" in
  *'"hook_event_name"'*'"UserPromptSubmit"'*) event="UserPromptSubmit" ;;
  *) event="PreToolUse" ;;
esac

# Cache layout: scripts/resolve-h2t-python.sh is at ../scripts/ (plugin root = ../)
# Dev layout: scripts/ is at plugins/h2t-core/ (repo root = ../../..)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/../scripts/resolve-h2t-python.sh" ]; then
  PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
else
  PLUGIN_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)/plugins/h2t-core"
fi

# Never cd into PLUGIN_ROOT. Its vendored lib/ has no `cli` package, so it shadows an
# installed `lib` and `-m lib.cli.main` raises ModuleNotFoundError even on an interpreter
# that has the wheel — which is how this hook died silently from 14e2b42 until #378. The
# plugin scripts take --cwd, so the working directory is irrelevant to them.
source "$PLUGIN_ROOT/scripts/resolve-h2t-python.sh"
if ! resolve_h2t_python "import yaml" pyyaml; then
  # emit() needs the interpreter we just failed to find, so this envelope is hand-written.
  # Safe only because the text is a fixed literal with nothing to escape — and it still has
  # to honour the per-event channel, or the slash user is told nothing at all.
  _err="GATHER_ERROR: no Python with PyYAML found. Install uv (https://astral.sh/uv) or set H2T_PYTHON to an interpreter that has it."
  if [ "$event" = "UserPromptSubmit" ]; then
    printf '{"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": "%s"}}\n' "$_err"
  else
    printf '{"systemMessage": "%s"}\n' "$_err"
  fi
  exit 0
fi

# json.dumps, not hand-rolled escaping: a tab or CR in the briefing would otherwise
# produce an invalid envelope.
#
# Channel by event: the model reads hookSpecificOutput.additionalContext, while
# systemMessage is the user-visible TUI line. UserPromptSubmit is a member of the
# hookSpecificOutput union, so the modern protocol validates there.
#
# stdin is read as bytes and decoded explicitly. `sys.stdin.read()` uses the console code
# page on Windows and, under UTF-8 mode, the surrogateescape handler — so one undecodable
# byte becomes a lone surrogate, json.dumps writes \udcd1, and the API rejects not just
# this request but every later one in the session: the string is in the conversation now.
# Measured on AUTOMATA 2026-08-27 as `400 ... invalid high surrogate`, in two chats.
#
# Two upstreams hand over such bytes and neither is hypothetical: `tail -c 500` below cuts
# stderr by BYTES and leaves half a UTF-8 character, and a localized Windows error arrives
# in the console code page. errors="replace" is what makes those a visible U+FFFD instead
# of an invisible surrogate — it cannot emit one, which is the whole point of choosing it
# over surrogateescape. stdout is written as bytes for the same reason: json.dumps is pure
# ASCII, so no console code page can touch the envelope on the way out.
emit() {
  printf '%s' "$1" | "${H2T_PYTHON_CMD[@]}" -c \
    'import json, sys
text = sys.stdin.buffer.read().decode("utf-8", "replace")
event = sys.argv[1]
if event == "UserPromptSubmit":
    envelope = {"hookSpecificOutput": {"hookEventName": event, "additionalContext": text}}
else:
    envelope = {"systemMessage": text}
sys.stdout.buffer.write(json.dumps(envelope).encode("ascii"))' "$event"
}

SCRIPT_STDOUT=""
SCRIPT_STDERR=""
# Run a plugin script, keeping stdout, stderr and the exit code apart. Discarding any of
# them lets a half-written payload from a crashed script pass for a real one.
# Same capture as run_script, without the interpreter prefix: the CLI is its own program.
run_cli() {
  local out err rc
  out=$(mktemp)
  err=$(mktemp)
  set +e
  "$@" >"$out" 2>"$err"
  rc=$?
  set -e
  SCRIPT_STDOUT=$(cat "$out")
  SCRIPT_STDERR=$(tail -c 500 "$err")
  rm -f "$out" "$err"
  return "$rc"
}

run_script() {
  local out err rc
  out=$(mktemp)
  err=$(mktemp)
  set +e
  "${H2T_PYTHON_CMD[@]}" "$@" >"$out" 2>"$err"
  rc=$?
  set -e
  SCRIPT_STDOUT=$(cat "$out")
  SCRIPT_STDERR=$(tail -c 500 "$err")
  rm -f "$out" "$err"
  return "$rc"
}

# Parse both payload shapes: PreToolUse carries tool_input.skill; UserPromptSubmit (handed
# over by gather-on-prompt) carries the prompt, whose leading slash command names the skill.
# Read as bytes for the same reason as emit(). One field per line; cwd last, so a path
# with any character but a newline survives.
if ! parsed=$(printf '%s' "$input" | "${H2T_PYTHON_CMD[@]}" -c \
  'import json, re, sys
d = json.loads(sys.stdin.buffer.read().decode("utf-8", "replace"))
event = d.get("hook_event_name") or ("UserPromptSubmit" if "prompt" in d or "user_prompt" in d else "PreToolUse")
skill = (d.get("tool_input") or {}).get("skill") or ""
if event == "UserPromptSubmit":
    prompt = d.get("prompt") or d.get("user_prompt") or ""
    m = re.match(r"\s*/((?:[A-Za-z0-9_.-]+:)?(?:session-start|handoff|init-project))(?:\s|$)", prompt)
    skill = m.group(1) if m else ""
sys.stdout.write("\n".join([event, skill, d.get("cwd") or "."]))' 2>/dev/null); then
  emit "GATHER_ERROR: could not parse the hook payload."
  exit 0
fi
event=$(printf '%s\n' "$parsed" | sed -n 1p)
skill=$(printf '%s\n' "$parsed" | sed -n 2p)
cwd=$(printf '%s\n' "$parsed" | sed -n '3,$p')

# Only fire for h2t-core session skills
case "$skill" in
  *session-start*|*handoff*|*init-project*) ;;
  *) exit 0 ;;
esac

# Deduplicate: skip if the same skill was gathered for the same directory in the last 30s.
# Keyed by cwd as well as skill, so a run in one repo cannot silence another; written only
# after a successful run, so a failure does not suppress the retry.
LOCK_KEY="$(echo "$skill" | tr '/:' '__')_$(printf '%s' "$cwd" | cksum | awk '{print $1}')"
LOCK_FILE="${TMPDIR:-/tmp}/h2t_gather_${LOCK_KEY}.lock"
NOW=$(date +%s)
if [ -f "$LOCK_FILE" ]; then
  LOCK_TIME=$(cat "$LOCK_FILE" 2>/dev/null || echo 0)
  AGE=$(( NOW - LOCK_TIME )) || AGE=99
  if [ "$AGE" -lt 30 ]; then
    exit 0
  fi
fi

if [[ "$skill" == *init-project* ]]; then
  # SKILL.md step 1 reads INIT_DATA; detection is what it asks for, not a briefing.
  if ! run_script "$PLUGIN_ROOT/skills/init-project/scripts/detect_project.py" --cwd "$cwd"; then
    emit "INIT_ERROR: detect_project.py failed. ${SCRIPT_STDERR:-no stderr}"
    exit 0
  fi
  if [ -z "$SCRIPT_STDOUT" ]; then
    emit "INIT_ERROR: detect_project.py returned no output. Check Python resolution."
    exit 0
  fi
  echo "$NOW" > "$LOCK_FILE"
  emit "INIT_DATA: $SCRIPT_STDOUT"
  exit 0
fi

# --briefing-only prints the injection format verbatim, so there is nothing to reformat
# here and no second assembly of the payload to drift from the CLI path.
# Prefer the installed CLI so the hook resolves the same plugin root a skill would:
# h2t-gather walks the ladder in h2t_ops/plugin_entrypoints.py (operator override ->
# CLAUDE_PLUGIN_ROOT -> editable checkout -> plugin cache -> frozen payload), while calling
# the script directly pins the hook to whichever cache copy sits beside this handler. Every
# SKILL.md already gates on `command -v h2t-gather`, so the script path is the fallback for
# a machine where the wheel was never installed.
if command -v h2t-gather >/dev/null 2>&1; then
  if ! run_cli h2t-gather --cwd "$cwd" --briefing-only; then
    emit "GATHER_ERROR: h2t-gather failed. ${SCRIPT_STDERR:-no stderr}"
    exit 0
  fi
elif ! run_script "$PLUGIN_ROOT/skills/session-start/scripts/gather.py" --cwd "$cwd" --briefing-only; then
  emit "GATHER_ERROR: gather.py failed. ${SCRIPT_STDERR:-no stderr}"
  exit 0
fi
if [ -z "$SCRIPT_STDOUT" ]; then
  emit "GATHER_ERROR: h2t gather returned no output. Run /h2t-core:setup doctor, or reinstall the CLI with uv tool install."
  exit 0
fi
echo "$NOW" > "$LOCK_FILE"
emit "$SCRIPT_STDOUT"
