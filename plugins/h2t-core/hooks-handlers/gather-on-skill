#!/usr/bin/env bash
# PreToolUse: inject context when h2t-core session skills are invoked.
#
# The hook is the executor on purpose. 672249e (2026-03-25) moved gathering out of the
# model's hands — "Closes #12 — gather.py can no longer be ignored by Claude". Do not
# replace this with an instruction telling the agent to run something itself.
set -euo pipefail

input=$(cat)
skill=$(echo "$input" | jq -r '.tool_input.skill // ""')
cwd=$(echo "$input" | jq -r '.cwd // "."')

# Only fire for h2t-core session skills
case "$skill" in
  *session-start*|*handoff*|*init-project*) ;;
  *) exit 0 ;;
esac

# Deduplicate: skip if same skill was gathered in the last 30s
LOCK_KEY=$(echo "$skill" | tr '/:' '__')
LOCK_FILE="${TMPDIR:-/tmp}/h2t_gather_${LOCK_KEY}.lock"
NOW=$(date +%s)
if [ -f "$LOCK_FILE" ]; then
  LOCK_TIME=$(cat "$LOCK_FILE" 2>/dev/null || echo 0)
  AGE=$(( NOW - LOCK_TIME )) || AGE=99
  if [ "$AGE" -lt 30 ]; then
    exit 0
  fi
fi
echo "$NOW" > "$LOCK_FILE"

# Cache layout: scripts/resolve-h2t-python.sh is at ../scripts/ (plugin root = ../)
# Dev layout: scripts/ is at plugins/h2t-core/ (repo root = ../../..)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/../scripts/resolve-h2t-python.sh" ]; then
  PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
else
  PLUGIN_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)/plugins/h2t-core"
fi

# Never cd into PLUGIN_ROOT. Its vendored lib/ has no `cli` package, so it shadows an
# installed `lib` and `-m lib.cli.main` raises ModuleNotFoundError even on an interpreter
# that has the wheel — which is how this hook died silently from 14e2b42 until #378. The
# plugin scripts take --cwd, so the working directory is irrelevant to them.
source "$PLUGIN_ROOT/scripts/resolve-h2t-python.sh"
if ! resolve_h2t_python "import yaml"; then
  echo '{"systemMessage": "GATHER_ERROR: no Python with PyYAML found. Install it into ~/.h2t/venv or set H2T_PYTHON."}'
  exit 0
fi

# Escape a plain message into the systemMessage JSON field.
emit() {
  printf '{"systemMessage": "%s"}' "$("${H2T_PYTHON_CMD[@]}" -c "
import sys
print(sys.stdin.read()
  .replace('\\\\', '\\\\\\\\')
  .replace('\"', '\\\\\"')
  .replace(chr(10), '\\\\n')
)" <<< "$1")"
}

if [[ "$skill" == *init-project* ]]; then
  # SKILL.md step 1 reads INIT_DATA; detection is what it asks for, not a briefing.
  DETECT="$PLUGIN_ROOT/skills/init-project/scripts/detect_project.py"
  RESULT=$("${H2T_PYTHON_CMD[@]}" "$DETECT" --cwd "$cwd" 2>/dev/null) || true
  if [ -z "$RESULT" ]; then
    emit "INIT_ERROR: detect_project.py returned no output. Check Python resolution."
    exit 0
  fi
  emit "INIT_DATA: $RESULT"
  exit 0
fi

# --briefing-only prints the injection format verbatim, so there is nothing to reformat
# here and no second assembly of the payload to drift from the CLI path.
GATHER="$PLUGIN_ROOT/skills/session-start/scripts/gather.py"
RESULT=$("${H2T_PYTHON_CMD[@]}" "$GATHER" --cwd "$cwd" --briefing-only 2>/dev/null) || true
if [ -z "$RESULT" ]; then
  emit "GATHER_ERROR: h2t gather returned no output. Check Python resolution or recreate ~/.h2t/venv."
  exit 0
fi
emit "$RESULT"
