#!/usr/bin/env bash
# PreToolUse: gather context when h2t-core session skills are invoked.
set -euo pipefail

input=$(cat)
skill=$(echo "$input" | jq -r '.tool_input.skill // ""')
cwd=$(echo "$input" | jq -r '.cwd // "."')

# Only fire for h2t-core session skills
case "$skill" in
  *session-start*|*handoff*|*init-project*) ;;
  *) exit 0 ;;
esac

# Deduplicate: skip if same skill was gathered in the last 30s
LOCK_KEY=$(echo "$skill" | tr '/:' '__')
LOCK_FILE="${TMPDIR:-/tmp}/h2t_gather_${LOCK_KEY}.lock"
NOW=$(date +%s)
if [ -f "$LOCK_FILE" ]; then
  LOCK_TIME=$(cat "$LOCK_FILE" 2>/dev/null || echo 0)
  AGE=$(( NOW - LOCK_TIME )) || AGE=99
  if [ "$AGE" -lt 30 ]; then
    exit 0
  fi
fi
echo "$NOW" > "$LOCK_FILE"

# Run gather CLI (must run from dir containing lib/ so lib.cli.main is importable)
# Cache layout: scripts/resolve-h2t-python.sh is at ../scripts/ (plugin root = ../)
# Dev layout: scripts/ is at plugins/h2t-core/ (repo root = ../../..)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/../scripts/resolve-h2t-python.sh" ]; then
  REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
  PLUGIN_ROOT="$REPO_ROOT"
else
  REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
  PLUGIN_ROOT="$REPO_ROOT/plugins/h2t-core"
fi

# Find Python
source "$PLUGIN_ROOT/scripts/resolve-h2t-python.sh"
if ! resolve_h2t_python; then
  echo '{"systemMessage": "GATHER_ERROR: no working Python found for h2t. Recreate ~/.h2t/venv or set H2T_PYTHON."}'
  exit 0
fi

# Build args
ARGS=("$skill" "--cwd" "$cwd")
[[ "$skill" == *session-start* ]] && ARGS+=("--format-briefing")

RESULT=$(cd "$REPO_ROOT" && "${H2T_PYTHON_CMD[@]}" -m lib.cli.main gather "${ARGS[@]}" 2>/dev/null) || true

if [ -z "$RESULT" ]; then
  echo '{"systemMessage": "GATHER_ERROR: h2t gather returned no output. Check Python resolution or recreate ~/.h2t/venv."}'
  exit 0
fi

# Format output for Claude systemMessage injection
BRIEFING=$("${H2T_PYTHON_CMD[@]}" -c "
import json, sys
data = json.load(sys.stdin)
b = data.get('_briefing', '')
m = json.dumps(data.get('_meta', {}))
print(f'BRIEFING:\n{b}\n\nGATHER_META: {m}')
" <<< "$RESULT" 2>/dev/null) || BRIEFING="GATHER_DATA: $RESULT"

printf '{"systemMessage": "%s"}' "$("${H2T_PYTHON_CMD[@]}" -c "
import sys
print(sys.stdin.read()
  .replace('\\\\', '\\\\\\\\')
  .replace('\"', '\\\\\"')
  .replace(chr(10), '\\\\n')
)" <<< "$BRIEFING")"
