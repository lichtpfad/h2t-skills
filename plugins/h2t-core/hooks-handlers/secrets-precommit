#!/usr/bin/env bash
# git pre-commit: a secret is caught in the staged diff, before it has a commit hash.
#
# The CI gitleaks job scans history and fails the run — after the secret is already in
# a pushed commit and must be rotated. h2t-transcription's HuggingFace token
# (realtime_subtitles.bat, 2026-07-19) sat there for seven weeks before anything ran.
# Needs the gitleaks binary on PATH (brew/winget/scoop, or the release tarball); when it
# is absent this prints one line and exits 0 — a missing tool must not block commits,
# but it must not be silent either. Exit 1 blocks the commit.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "h2t secrets-precommit: gitleaks not on PATH — staged diff not scanned (install: https://github.com/gitleaks/gitleaks/releases)" >&2
  exit 0
fi

if gitleaks git --staged --redact --no-banner --exit-code 1 . >/dev/null 2>&1; then
  exit 0
fi
echo "h2t secrets-precommit: gitleaks found a secret in the staged diff. Refused." >&2
echo "  see: gitleaks git --staged --redact -v ." >&2
exit 1
