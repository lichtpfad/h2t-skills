#!/usr/bin/env bash
# Creative Thinking eval tracker
# Called by hooks: post-bash (track graph queries), stop (save session)

set -euo pipefail

EVAL_DIR="$HOME/.h2t/evals/creative-thinking"
ACTIVE_FILE="$EVAL_DIR/.active_session.jsonl"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

EVENT="$1"
INPUT=$(cat)

case "$EVENT" in
  post-bash)
    # Extract the command that was run
    COMMAND=$(echo "$INPUT" | python -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('tool_input', {}).get('command', ''))
except:
    print('')
" 2>/dev/null || echo "")

    # Only track h2t graph --source creative calls
    if echo "$COMMAND" | grep -q "h2t graph.*--source creative"; then
      # Extract nodes and tokens from output
      RESULT=$(echo "$INPUT" | python -c "
import sys, json, re
try:
    d = json.load(sys.stdin)
    output = d.get('tool_result', '')
    if isinstance(output, dict):
        output = output.get('stdout', '') or output.get('output', '') or str(output)
    output = str(output)
    m = re.search(r'(\d+) nodes \| ~(\d+) tokens', output)
    nodes = int(m.group(1)) if m else 0
    tokens = int(m.group(2)) if m else 0
    print(json.dumps({'nodes': nodes, 'tokens_estimate': tokens}))
except:
    print('{\"nodes\":0,\"tokens_estimate\":0}')
" 2>/dev/null || echo '{"nodes":0,"tokens_estimate":0}')

      mkdir -p "$EVAL_DIR"
      TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
      echo "{\"event\":\"graph_query\",\"timestamp\":\"$TIMESTAMP\",\"command\":\"$COMMAND\",\"result\":$RESULT}" >> "$ACTIVE_FILE"
    fi
    ;;

  stop)
    python "$SCRIPT_DIR/ct-finalize.py" 2>/dev/null || true
    ;;
esac
