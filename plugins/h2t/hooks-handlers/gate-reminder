#!/usr/bin/env bash
# PostToolUse hook: after ctx-load or dev-session-start skill loads,
# inject a reminder to propose session name.
set -euo pipefail

input=$(cat)
tool=$(echo "$input" | jq -r '.tool_name // ""')
skill=$(echo "$input" | jq -r '.tool_input.skill // ""')

# Only fire for Skill tool on our skills
[ "$tool" != "Skill" ] && exit 0

case "$skill" in
  *ctx-load*|*dev-session-start*) ;;
  *) exit 0 ;;
esac

# Read the slug_template from the PreToolUse systemMessage if available
# We can't access previous messages, but we can remind Claude
cat <<'REMINDER'
{
  "systemMessage": "REMINDER: После показа брифинга ты ДОЛЖЕН предложить имя сессии. Формат:\n\nПредлагаю имя сессии: `{slug}`\nНаправление: #{номер} {title}\nКорректируй если нужно.\n\nНЕ заканчивай ответ словами 'Что делаем?' или 'Готов к работе.' — предложи направление сам."
}
REMINDER
