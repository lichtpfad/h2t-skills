#!/usr/bin/env bash
# PreToolUse hook: run gather.py when dev-session-start or handoff skill is invoked.
# Returns gather JSON + computed paths as systemMessage.
set -euo pipefail

input=$(cat)
skill=$(echo "$input" | jq -r '.tool_input.skill // ""')
cwd=$(echo "$input" | jq -r '.cwd // "."')

# Determine which skill triggered and which gather.py to use
SKILL_NAME=""
if [[ "$skill" == *"dev-session-start"* ]]; then
  SKILL_NAME="dev-session-start"
elif [[ "$skill" == *"handoff"* ]]; then
  SKILL_NAME="handoff"
elif [[ "$skill" == *"init-project"* ]]; then
  SKILL_NAME="init-project"
fi

# Exit silently for other skills
[ -z "$SKILL_NAME" ] && exit 0

# Detect python
H2T_PYTHON="${H2T_PYTHON:-}"
if [ -z "$H2T_PYTHON" ]; then
  if [ -f "$HOME/.h2t/venv/Scripts/python.exe" ]; then
    H2T_PYTHON="$HOME/.h2t/venv/Scripts/python.exe"
  elif [ -f "$HOME/.h2t/venv/bin/python" ]; then
    H2T_PYTHON="$HOME/.h2t/venv/bin/python"
  fi
fi

if [ -z "$H2T_PYTHON" ]; then
  echo '{"systemMessage": "GATHER_ERROR: h2t venv not found. Run /h2t:setup"}'
  exit 0
fi

# Find skill-specific gather.py
case "$SKILL_NAME" in
  init-project)  SCRIPT_NAME="detect_project.py" ;;
  *)             SCRIPT_NAME="gather.py" ;;
esac
GATHER_PY="${CLAUDE_PLUGIN_ROOT}/skills/${SKILL_NAME}/scripts/${SCRIPT_NAME}"
if [ ! -f "$GATHER_PY" ]; then
  echo '{"systemMessage": "GATHER_ERROR: '"$SCRIPT_NAME"' not found at '"$GATHER_PY"'"}'
  exit 0
fi

# Build gather args — format-briefing only for dev-session-start
GATHER_ARGS="--cwd $cwd"
if [ "$SKILL_NAME" = "dev-session-start" ]; then
  GATHER_ARGS="$GATHER_ARGS --format-briefing"
fi
RESULT=$("$H2T_PYTHON" "$GATHER_PY" $GATHER_ARGS 2>/dev/null) || true

if [ -z "$RESULT" ]; then
  echo '{"systemMessage": "GATHER_ERROR: gather.py returned empty output"}'
  exit 0
fi

# Validate JSON
echo "$RESULT" | jq . >/dev/null 2>&1 || {
  echo '{"systemMessage": "GATHER_ERROR: gather.py returned invalid JSON"}'
  exit 0
}

# For handoff: compute correct session file path and inject it
if [ "$SKILL_NAME" = "handoff" ]; then
  "$H2T_PYTHON" -c "
import sys, json, os

raw = sys.stdin.read().strip()
data = json.loads(raw)

machine = data.get('machine', 'unknown').lower()
git = data.get('git', {})
remote = git.get('remote', '')
owner_repo = git.get('owner_repo', '')

# Extract repo name from remote
repo = ''
if owner_repo:
    repo = owner_repo.split('/')[-1] if '/' in owner_repo else owner_repo
elif remote:
    repo = remote.rstrip('/').split('/')[-1].replace('.git', '')
else:
    repo = os.path.basename(os.path.abspath(data.get('project', {}).get('id', 'unknown')))

session_dir = os.path.expanduser(f'~/.dor/sessions/{machine}/{repo}')
# Normalize to forward slashes for cross-platform consistency
session_dir = session_dir.replace(os.sep, '/')

# Add computed paths to the data
data['_handoff'] = {
    'session_dir': session_dir,
    'session_dir_cmd': f'mkdir -p \"{session_dir}\"',
}

output = {'systemMessage': 'GATHER_DATA: ' + json.dumps(data)}
print(json.dumps(output))
" <<< "$RESULT"
elif [ "$SKILL_NAME" = "init-project" ]; then
  "$H2T_PYTHON" -c "
import sys, json
raw = sys.stdin.read().strip()
output = {'systemMessage': 'INIT_DATA: ' + raw}
print(json.dumps(output, ensure_ascii=False))
" <<< "$RESULT"
else
  # dev-session-start: return briefing + full instructions in systemMessage
  "$H2T_PYTHON" -c "
import sys, json, io
sys.stdin = io.TextIOWrapper(sys.stdin.buffer, encoding='utf-8', errors='replace')
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
raw = sys.stdin.read().strip()
data = json.loads(raw)
briefing = data.pop('_briefing', '')
meta = data.pop('_meta', {})

if not briefing:
    output = {'systemMessage': 'GATHER_DATA: ' + raw}
    print(json.dumps(output, ensure_ascii=False))
    sys.exit(0)

slug = meta.get('slug_template', '')
sessions = meta.get('sessions', [])
user = meta.get('user', {})
core_path = user.get('core_path', '')

instructions = '''=== DEV-SESSION-START ===

Все данные уже собраны. Твой ответ должен содержать ДВЕ части в ОДНОМ сообщении:

ЧАСТЬ 1 — покажи этот брифинг:

''' + briefing + '''

ЧАСТЬ 2 — предложи имя сессии и направление (в том же сообщении, сразу после брифинга):

Шаблон slug: ''' + slug + '''
Заполни {task} на основе top-priority issue (2-4 слова, kebab-case).

Формат ЧАСТИ 2:
---
Предлагаю имя сессии: `{заполненный slug}`
Направление: #{номер} {title} — {почему это приоритет}
Корректируй если нужно.

НЕ заканчивай ответ только брифингом. НЕ спрашивай "Что делаем?" — предложи сам.
НЕ запускай git, gh, или другие команды. Данные уже в брифинге.'''

# Add session/context hints
if sessions:
    instructions += '\\n\\nHandoff-файлы для чтения (max 2 newest): ' + json.dumps(sessions[:2], ensure_ascii=False)
if core_path:
    instructions += '\\n\\nUser context: ' + core_path

output = {'systemMessage': instructions}
print(json.dumps(output, ensure_ascii=False))
" <<< "$RESULT"
fi
exit 0
