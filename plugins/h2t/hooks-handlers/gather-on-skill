#!/usr/bin/env bash
# PreToolUse hook: run gather.py when dev-session-start or handoff skill is invoked.
# Returns gather JSON + computed paths as systemMessage.
set -euo pipefail

input=$(cat)
skill=$(echo "$input" | jq -r '.tool_input.skill // ""')
cwd=$(echo "$input" | jq -r '.cwd // "."')

# Determine which skill triggered and which gather.py to use
SKILL_NAME=""
if [[ "$skill" == *"dev-session-start"* ]]; then
  SKILL_NAME="dev-session-start"
elif [[ "$skill" == *"handoff"* ]]; then
  SKILL_NAME="handoff"
fi

# Exit silently for other skills
[ -z "$SKILL_NAME" ] && exit 0

# Detect python
H2T_PYTHON="${H2T_PYTHON:-}"
if [ -z "$H2T_PYTHON" ]; then
  if [ -f "$HOME/.h2t/venv/Scripts/python.exe" ]; then
    H2T_PYTHON="$HOME/.h2t/venv/Scripts/python.exe"
  elif [ -f "$HOME/.h2t/venv/bin/python" ]; then
    H2T_PYTHON="$HOME/.h2t/venv/bin/python"
  fi
fi

if [ -z "$H2T_PYTHON" ]; then
  echo '{"systemMessage": "GATHER_ERROR: h2t venv not found. Run /h2t:setup"}'
  exit 0
fi

# Find skill-specific gather.py
GATHER_PY="${CLAUDE_PLUGIN_ROOT}/skills/${SKILL_NAME}/scripts/gather.py"
if [ ! -f "$GATHER_PY" ]; then
  echo '{"systemMessage": "GATHER_ERROR: gather.py not found at '"$GATHER_PY"'"}'
  exit 0
fi

# Build gather args — format-briefing only for dev-session-start
GATHER_ARGS="--cwd $cwd"
if [ "$SKILL_NAME" = "dev-session-start" ]; then
  GATHER_ARGS="$GATHER_ARGS --format-briefing"
fi
RESULT=$("$H2T_PYTHON" "$GATHER_PY" $GATHER_ARGS 2>/dev/null) || true

if [ -z "$RESULT" ]; then
  echo '{"systemMessage": "GATHER_ERROR: gather.py returned empty output"}'
  exit 0
fi

# Validate JSON
echo "$RESULT" | jq . >/dev/null 2>&1 || {
  echo '{"systemMessage": "GATHER_ERROR: gather.py returned invalid JSON"}'
  exit 0
}

# For handoff: compute correct session file path and inject it
if [ "$SKILL_NAME" = "handoff" ]; then
  "$H2T_PYTHON" -c "
import sys, json, os

raw = sys.stdin.read().strip()
data = json.loads(raw)

machine = data.get('machine', 'unknown').lower()
git = data.get('git', {})
remote = git.get('remote', '')
owner_repo = git.get('owner_repo', '')

# Extract repo name from remote
repo = ''
if owner_repo:
    repo = owner_repo.split('/')[-1] if '/' in owner_repo else owner_repo
elif remote:
    repo = remote.rstrip('/').split('/')[-1].replace('.git', '')
else:
    repo = os.path.basename(os.path.abspath(data.get('project', {}).get('id', 'unknown')))

session_dir = os.path.expanduser(f'~/.dor/sessions/{machine}/{repo}')
# Normalize to forward slashes for cross-platform consistency
session_dir = session_dir.replace(os.sep, '/')

# Add computed paths to the data
data['_handoff'] = {
    'session_dir': session_dir,
    'session_dir_cmd': f'mkdir -p \"{session_dir}\"',
}

output = {'systemMessage': 'GATHER_DATA: ' + json.dumps(data)}
print(json.dumps(output))
" <<< "$RESULT"
else
  # dev-session-start: return pre-formatted briefing + meta
  "$H2T_PYTHON" -c "
import sys, json
raw = sys.stdin.read().strip()
data = json.loads(raw)
briefing = data.pop('_briefing', '')
meta = data.pop('_meta', {})
if briefing:
    msg = 'BRIEFING:\n' + briefing + '\nGATHER_META: ' + json.dumps(meta, ensure_ascii=False)
    output = {'systemMessage': msg}
else:
    output = {'systemMessage': 'GATHER_DATA: ' + raw}
print(json.dumps(output, ensure_ascii=False))
" <<< "$RESULT"
fi
exit 0
