#!/usr/bin/env sh
# Pre-commit hook: block commits that drift .claude-plugin/marketplace.json
# against any plugin's own plugin.json. See lichtpfad/h2t-skills#74.
#
# Install once per clone:
#   sh scripts/hooks/install.sh
#
# Bypass (rarely, for drift acknowledgement commits):
#   git commit --no-verify

set -e

# Only run when plugin or marketplace files change. Cheap guard.
if git diff --cached --name-only | grep -qE '(^|/)(plugin|marketplace)\.json$'; then
  python_bin=""
  if [ -f "$HOME/.h2t/venv/Scripts/python.exe" ]; then
    python_bin="$HOME/.h2t/venv/Scripts/python.exe"
  elif [ -f "$HOME/.h2t/venv/bin/python" ]; then
    python_bin="$HOME/.h2t/venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    python_bin="python3"
  elif command -v python >/dev/null 2>&1; then
    python_bin="python"
  else
    echo "pre-commit: no python found — skipping marketplace drift check" >&2
    exit 0
  fi

  repo_root="$(git rev-parse --show-toplevel)"
  "$python_bin" "$repo_root/scripts/check_marketplace_sync.py"
fi
