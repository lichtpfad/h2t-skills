{
  "permissions": {
    "allow": [
      "mcp__anysite__search_instagram_posts",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.skill // \"\"' | grep -qE '(session-start|handoff)' && (mkdir -p ~/.h2t && touch ~/.h2t/.gather-active); echo '{}'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if find ~/.h2t/.gather-active -mmin -5 2>/dev/null | grep -q .; then jq -r '.tool_input.command' | grep -qE '^(git log|git status|git branch|git diff|git stash|gh issue list|gh pr list|gh milestone list)\\s*$' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Контекст уже собран gather-on-skill hook (BRIEFING). Во время session-start/handoff не дублируй scrape — используй данные из BRIEFING. Блок снимается автоматически через 5 минут после старта.\"}}' || echo '{}'; else echo '{}'; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@codex-plugins": true,
    "h2t-core@lichtpfad": true,
    "h2t-dev@lichtpfad": true,
    "plugin-dev@plugin-dev-plugins": true,
    "superpowers@superpowers-plugins": true,
    "h2t-creative@lichtpfad": false,
    "h2t-dcc@lichtpfad": false,
    "lead-search@lead-search-plugins": false,
    "marketing-playbook@marketing-playbook-plugins": false,
    "pm-data-analytics@pm-data-analytics-plugins": false,
    "pm-execution@pm-execution-plugins": false,
    "pm-go-to-market@pm-go-to-market-plugins": false,
    "pm-market-research@pm-market-research-plugins": false,
    "pm-marketing-growth@pm-marketing-growth-plugins": false,
    "pm-product-discovery@pm-product-discovery-plugins": false,
    "pm-product-strategy@pm-product-strategy-plugins": false
  },
  "h2tAgentProfile": {
    "base": "dev",
    "overlays": [],
    "managedBy": "h2t-core:agent-profile",
    "updatedAt": "2026-05-22"
  }
}
