{
  "permissions": {
    "allow": [
      "mcp__anysite__search_instagram_posts",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.skill // \"\"' | grep -qE '(session-start|handoff)' && (mkdir -p ~/.h2t && touch ~/.h2t/.gather-active); echo '{}'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if find ~/.h2t/.gather-active -mmin -5 2>/dev/null | grep -q .; then jq -r '.tool_input.command' | grep -qE '^(git log|git status|git branch|git diff|git stash|gh issue list|gh pr list|gh milestone list)\\s*$' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u0443\u0436\u0435 \u0441\u043e\u0431\u0440\u0430\u043d gather-on-skill hook (BRIEFING). \u0412\u043e \u0432\u0440\u0435\u043c\u044f session-start/handoff \u043d\u0435 \u0434\u0443\u0431\u043b\u0438\u0440\u0443\u0439 scrape \u2014 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438\u0437 BRIEFING. \u0411\u043b\u043e\u043a \u0441\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 5 \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0441\u043b\u0435 \u0441\u0442\u0430\u0440\u0442\u0430.\"}}' || echo '{}'; else echo '{}'; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.prompt // \"\"' | grep -qE '^[[:space:]]*/([A-Za-z0-9_.-]+:)?(session-start|handoff)' && (mkdir -p ~/.h2t && touch ~/.h2t/.gather-active); echo '{}'"
          }
        ]
      }
    ]
  },
  "h2tAgentProfile": {
    "base": "dev",
    "overlays": [],
    "managedBy": "h2t-core:agent-profile",
    "updatedAt": "2026-05-22"
  }
}
