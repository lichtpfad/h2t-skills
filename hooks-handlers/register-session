#!/usr/bin/env bash
# Register Claude Code session in Session Registry (DOR #12)
# Called by SessionStart hook. Reads JSON from stdin.
set -euo pipefail

# Read JSON from stdin
INPUT=$(cat)

# Parse fields using python (available on both machines)
SESSION_ID=$(echo "$INPUT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('session_id',''))" 2>/dev/null || echo "")
CWD=$(echo "$INPUT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('cwd',''))" 2>/dev/null || echo "")

# Skip if no session ID
[ -z "$SESSION_ID" ] && exit 0

# Find registry.py in config repo
CONFIG_ROOT="${DOR_CONFIG_ROOT:-$HOME/config}"
# Windows fallback paths
if [ ! -d "$CONFIG_ROOT" ]; then
  for candidate in "/c/dev/config" "$HOME/dev/config" "/mnt/c/dev/config"; do
    if [ -d "$candidate" ]; then
      CONFIG_ROOT="$candidate"
      break
    fi
  done
fi
REGISTRY_PY="$CONFIG_ROOT/registry/registry.py"

# Skip silently if config repo not cloned
[ ! -f "$REGISTRY_PY" ] && exit 0

# Register session
python3 "$REGISTRY_PY" append \
  --id "$SESSION_ID" \
  --cwd "$CWD" \
  --host "$(hostname -s 2>/dev/null || hostname)" 2>/dev/null || true

# Persist SESSION_ID for skills to use later (/session-start, /handoff)
if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
  echo "export DOR_SESSION_ID=$SESSION_ID" >> "$CLAUDE_ENV_FILE"
fi

exit 0
